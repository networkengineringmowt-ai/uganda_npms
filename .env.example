# Supabase connection for uganda_npms
# Copy this file to .env (or .env.local) and fill in the real values once
# the Supabase project exists. Never commit the real .env file.
#
# Public/browser-safe (used by the static frontend, e.g. via supabase-js):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# Server-side only (used by any migration/sync/rollup job, NOT the browser):
SUPABASE_SERVICE_ROLE_KEY=
